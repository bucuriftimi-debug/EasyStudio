{
  "name": "easystudio",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "photo:dev": "npm run dev -w @easystudio/photo",
    "photo:web": "npm run web -w @easystudio/photo",
    "photo:build": "npm run build -w @easystudio/photo",
    "photo:dist": "npm run dist -w @easystudio/photo",
    "typecheck": "npm run typecheck -w @easystudio/photo && npm run typecheck -w @easystudio/video",
    "test": "vitest run",
    "video:dev": "npm run dev -w @easystudio/video",
    "video:web": "npm run web -w @easystudio/video",
    "video:build": "npm run build -w @easystudio/video",
    "video:dist": "npm run dist -w @easystudio/video",
    "photo:store": "npm run store -w @easystudio/photo",
    "video:store": "npm run store -w @easystudio/video"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
